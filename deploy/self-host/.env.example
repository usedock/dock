# Self-hosted Dock control plane. Copy to .env next to docker-compose.yml.

# Caddy site address: a DNS name that points here (automatic HTTPS), or
# http://<ip> for plain HTTP on a private network (no confined GitHub runs then).
DOCK_SITE_ADDRESS=dock.example.com
# The public origin users, GitHub, and hosts use. Serves dashboard and API.
DOCK_PUBLIC_URL=https://dock.example.com
# Host ports Caddy binds. Change only when the site address carries the same port.
DOCK_HTTP_PORT=80
DOCK_HTTPS_PORT=443
# Host port for `ssh <dockId>@<host> -p <port>`; users add keys in the dashboard.
DOCK_SSH_PORT=2222
# Hosted ports: dock ports served at https://<port>-<random>.<domain>. Needs a
# wildcard DNS record (*.ports.example.com) pointing here; empty turns them off.
DOCK_PORTS_DOMAIN=
# Caddy site for port names; setup.sh derives it from DOCK_PUBLIC_URL, for
# example *.ports.example.com, or http://*.ports.localhost:8088 locally.
DOCK_PORTS_SITE_ADDRESS=

# Secrets: generate each once with `openssl rand -hex 32` and keep them.
# Losing SECRETS_ENCRYPTION_KEY orphans stored provider keys and env secrets.
# FLEET_TOKEN is what hosts join with.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
SECRETS_ENCRYPTION_KEY=
FLEET_TOKEN=
# Transition only: while true, the shared FLEET_TOKEN also authenticates heartbeat, poll and
# result for hosts that have no credential yet. Leave false once every host has registered.
FLEET_LEGACY_SHARED_TOKEN=false
SNAPSHOT_STORE_ACCESS_KEY=dock
SNAPSHOT_STORE_SECRET_KEY=

# Who may run instance setup (GitHub App registration). Comma list. Each email
# must be verified; with SMTP_HOST unset the link is in `docker compose logs backend`.
INSTANCE_ADMIN_EMAILS=you@example.com

# Optional SMTP. Empty SMTP_HOST writes mail (reset links, sign-in codes) to
# the backend log: `docker compose logs backend`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Dock <dock@example.com>
CONTACT_INBOX=admin@example.com

# Optional social sign-in; a provider shows only when both values are set.
# Callback URL: <DOCK_PUBLIC_URL>/api/auth/callback/<google|github>
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_CLIENT_SECRET=

# GitHub App for issue-to-PR runs. Register it from the dashboard
# (Developers > GitHub App > Register App) and paste the printed values here.
# Apps registered that way already carry the settings linking needs. For an
# existing App, in its GitHub settings: set the FIRST Callback URL to
# <DOCK_PUBLIC_URL>/developers/github/installed (the Setup URL is not used),
# tick "Request user authorization (OAuth) during installation", add the
# organization permission Members: read and approve it on each installation,
# then copy the Client ID and a client secret into the two CLIENT lines below.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# opencode model for runs; empty picks one from the organization's provider key.
GITHUB_RUN_MODEL=
# Extra HTTPS hosts confined runs may reach (comma list); `*` leaves egress open.
RUN_EGRESS_ALLOW=
# Let members connect their own ChatGPT Plus/Pro sign-in for runs they trigger.
# Unofficial: it reuses OpenAI's Codex CLI sign-in, which OpenAI may restrict.
CHATGPT_SIGNIN_ENABLED=false

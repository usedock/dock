# Copy to apps/backend/.env and fill secrets. Backend reads env from its own
# working directory (apps/backend/.env) with these same names.
# Production compose (docker-compose.prod.yml) needs these in .env.production
# too, passed via `--env-file`; DATABASE_URL must embed the same password.
# They only take effect on a fresh database volume (see docker-compose.prod.yml).
# POSTGRES_PASSWORD=<strong password>
# POSTGRES_USER=dock
# POSTGRES_DB=dock
DATABASE_URL=postgres://dock:dock@localhost:5432/dock
# Used instead of DATABASE_URL when NODE_ENV=test. Required for test boots.
TEST_DATABASE_URL=postgres://dock:dock@localhost:5432/dock_test
REDIS_URL=redis://localhost:6379
PORT=8000
# Public URLs. Unset means the hosted cloud (api/dashboard.usedock.io); a
# self-hosted instance must set both. They drive auth origins and cookies, mail
# links, GitHub callbacks and webhooks, and the OpenAPI server URL.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3002
# Legacy overrides; empty falls back to the PUBLIC_* values above.
APP_URL=
BETTER_AUTH_URL=
GITHUB_CALLBACK_BASE_URL=
# Extra origins trusted by auth (comma list) and the cross-subdomain cookie
# domain (unset derives it from the two public hosts, empty disables).
# AUTH_TRUSTED_ORIGINS=
# AUTH_COOKIE_DOMAIN=
BETTER_AUTH_SECRET=change-me-to-at-least-32-bytes-long-secret
# Social sign-in is optional: a provider appears only when its id and secret are both set.
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_CLIENT_SECRET=
# Emails (comma list) allowed to run instance setup, e.g. registering the
# GitHub App from the dashboard (Settings > GitHub App).
INSTANCE_ADMIN_EMAILS=
# GitHub App for @dock issue-to-PR runs. Optional until the App is
# configured; webhook and token mint fail closed while empty. Settings >
# GitHub App registers one through GitHub's manifest flow and prints these.
GITHUB_APP_ID=
GITHUB_APP_SLUG=dock
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PREV=
GITHUB_APP_WEBHOOK_SECRET=
# opencode model for issue-to-PR runs; empty picks one from the org's provider key.
GITHUB_RUN_MODEL=
# Hosts confined issue-to-PR runs may reach (comma list); empty uses the built-in
# registries + GitHub list, `*` disables confinement. The control plane is always allowed.
RUN_EGRESS_ALLOW=
# Let members connect their own ChatGPT Plus/Pro sign-in for runs they trigger.
# Unofficial: it reuses OpenAI's Codex CLI sign-in, which OpenAI may restrict.
CHATGPT_SIGNIN_ENABLED=false
# 32 random bytes as 64 hex chars (e.g. `openssl rand -hex 32`). Loss orphans stored secrets.
SECRETS_ENCRYPTION_KEY=
# Optional. Empty SMTP_HOST writes every mail (reset links, sign-in codes) to
# the backend log instead of delivering it. Email verification is not enforced.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Dock <hello@usedock.io>
# Inbox for the marketing contact form (/v1/contact). Replies go to the visitor.
CONTACT_INBOX=hello@usedock.io
# SSH gateway: `ssh -p <port> <dockId>@<host>` with keys from /v1/ssh-keys.
# Empty port disables SSH. Empty SSH_HOST_KEY derives a stable ed25519 host key
# from BETTER_AUTH_SECRET; set an OpenSSH private key (\n escapes ok) to pin one.
# SSH_PUBLIC_HOST/PORT are what the dashboard shows (default: API host, gateway port).
SSH_GATEWAY_PORT=
SSH_HOST_KEY=
SSH_PUBLIC_HOST=
SSH_PUBLIC_PORT=
# Hosted ports: exposed dock ports are served at https://<port>-<random>.<PORTS_DOMAIN>.
# Point a wildcard DNS record at the edge proxy, which terminates TLS and forwards
# to PORTS_PROXY_PORT with upstream keep-alive off (one request per connection).
# Must not sit under the auth cookie domain; a separate registrable domain is safest.
# Empty domain or port disables hosted ports.
PORTS_DOMAIN=
PORTS_PROXY_PORT=
# Dock runtime plane. `fake` serves lifecycle inline for dev/tests; `restate`
# drives the Go docklet on bare-metal hosts through Restate workflows.
RUNTIME_DRIVER=fake
FAST_RUN_ENABLED=false
RESTATE_INGRESS_URL=http://localhost:8080
# Direct mode only (RUNTIME_DRIVER != restate): the docklet serves plain HTTP on loopback.
DOCKLET_BASE_URL=http://127.0.0.1:8081
# Must match the docklet's DOCKLET_LOCAL_TOKEN; sent as a bearer token on every direct-mode call.
DOCKLET_LOCAL_TOKEN=
# Transition only: while true, the shared FLEET_TOKEN also authenticates heartbeat, poll and
# result for hosts that have no credential yet. Leave false once every host has registered.
FLEET_LEGACY_SHARED_TOKEN=false
# Optional mTLS for a docklet fronted by a TLS proxy; when all three are empty the client uses plain HTTP.
DOCKLET_CA_PATH=
DOCKLET_CERT_PATH=
DOCKLET_KEY_PATH=
# S3-compatible snapshot store (MinIO on the test host, S3 in prod).
SNAPSHOT_STORE_ENDPOINT=http://localhost:9000
SNAPSHOT_STORE_BUCKET=dock-snapshots
SNAPSHOT_STORE_ACCESS_KEY=
SNAPSHOT_STORE_SECRET_KEY=
# Address hosts dial for presigned transfers. A host cannot resolve an
# in-compose name like backend-minio:9000. Hosts transfer artifacts directly to
# the store over short-lived signed URLs, which is far faster than the object
# proxy, but only when this names an address a host can actually reach. Empty
# keeps every transfer on the proxy.
SNAPSHOT_STORE_PUBLIC_ENDPOINT=
# SigV4 signing region, and URL addressing/lifetime for presigned transfers.
SNAPSHOT_STORE_REGION=us-east-1
SNAPSHOT_STORE_PATH_STYLE=true
SNAPSHOT_STORE_PRESIGN_TTL_SECONDS=900
# Error reporting (Sentry). Empty DSN disables reporting entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENABLED=true

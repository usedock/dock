{{> eyebrow text="Password reset"}}
<h1 style="font-weight:500;font-size:30px;line-height:1.1;letter-spacing:-0.04em;margin:0 0 16px 0;">Choose a new password.</h1>
<p style="font-size:15px;line-height:1.75;color:rgba(17,18,15,0.8);margin:0;">Someone requested a password reset for {{email}} on Dock. This link expires in 1 hour. If that was not you, ignore this message.</p>
{{> button url=resetUrl label="Reset password"}}
<p style="font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:12px;color:rgba(17,18,15,0.65);word-break:break-all;margin:0;">If the button does not work, paste this link:<br>{{resetUrl}}</p>

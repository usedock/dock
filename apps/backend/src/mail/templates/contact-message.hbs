{{> eyebrow text="Contact form"}}
<h1 style="font-weight:500;font-size:30px;line-height:1.1;letter-spacing:-0.04em;margin:0 0 16px 0;">{{name}} wrote in.</h1>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:13px;line-height:1.6;">
<tr><td style="padding:4px 16px 4px 0;width:88px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(17,18,15,0.5);" valign="top">Reply to</td><td style="padding:4px 0;color:#11120f;word-break:break-all;">{{email}}</td></tr>
<tr><td style="padding:4px 16px 4px 0;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(17,18,15,0.5);" valign="top">Company</td><td style="padding:4px 0;color:#11120f;">{{company}}</td></tr>
<tr><td style="padding:4px 16px 4px 0;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(17,18,15,0.5);" valign="top">Topic</td><td style="padding:4px 0;color:#11120f;">{{topic}}</td></tr>
</table>
{{> divider}}
<p style="font-size:15px;line-height:1.75;color:rgba(17,18,15,0.8);margin:0;white-space:pre-wrap;word-break:break-word;">{{message}}</p>

{{> eyebrow text="Verify your email"}}
<h1 style="font-weight:500;font-size:30px;line-height:1.1;letter-spacing:-0.04em;margin:0 0 16px 0;">Confirm this address.</h1>
<p style="font-size:15px;line-height:1.75;color:rgba(17,18,15,0.8);margin:0;">Click below to verify {{email}} on Dock. This link expires in 24 hours.</p>
{{> button url=verifyUrl label="Verify email"}}
<p style="font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:12px;color:rgba(17,18,15,0.65);word-break:break-all;margin:0;">If the button does not work, paste this link:<br>{{verifyUrl}}</p>

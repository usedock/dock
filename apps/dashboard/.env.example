# Copy to .env.local. The dashboard holds no secrets: auth (including
# OAuth credentials) lives in apps/backend/.env.
# Public API origin, inlined into the client bundle at build time.
NEXT_PUBLIC_BETTER_AUTH_BACKEND_URL=http://localhost:8000
# Server-side API origin. Internal names like http://backend:8000 only resolve
# inside the self-host stack; the standalone prod dashboard has no backend network.
BETTER_AUTH_BACKEND_URL=http://localhost:8000
# Public dashboard origin (metadata) and docs link; empty uses the hosted defaults.
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_DOCS_URL=
# Fallback provider flags, used only when the backend's /v1/config is unreachable.
NEXT_PUBLIC_GOOGLE_ENABLED=true
NEXT_PUBLIC_GITHUB_ENABLED=true

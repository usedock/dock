{
  "scenario": "files-roundtrip",
  "variables": {
    "workspaceId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
    "run": "fixture"
  },
  "exchanges": [
    {
      "step": "create",
      "request": {
        "method": "POST",
        "path": "/v1/docks",
        "body": {
          "workspaceId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "name": "sdk-fixture-files",
          "cpus": 1,
          "memoryMiB": 1024,
          "diskGiB": 10
        }
      },
      "response": {
        "status": 201,
        "body": {
          "ok": true,
          "data": {
            "id": "22222222-2222-4222-8222-222222222222",
            "workspaceId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "name": "sdk-fixture-files",
            "cpus": 1,
            "memoryMiB": 1024,
            "diskGiB": 10,
            "image": "ubuntu-24.04",
            "runtime": "microvm",
            "state": "ready",
            "persistentPaths": [
              "/"
            ]
          }
        }
      }
    },
    {
      "step": "write",
      "request": {
        "method": "POST",
        "path": "/v1/docks/22222222-2222-4222-8222-222222222222/exec",
        "body": {
          "command": "d=$(dirname -- '/home/user/work/notes/hello.txt'; echo x) && mkdir -p -- \"${d%??}\" && printf '%s' 'aGVsbG8gZnJvbSBkb2NrCnNlY29uZCBsaW5lCg==' | base64 -d > '/home/user/work/notes/hello.txt'"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "data": {
            "exitCode": 0,
            "stdout": "",
            "stderr": "",
            "durationMs": 12,
            "truncated": false
          }
        }
      }
    },
    {
      "step": "read",
      "request": {
        "method": "POST",
        "path": "/v1/docks/22222222-2222-4222-8222-222222222222/exec",
        "body": {
          "command": "base64 -w0 -- '/home/user/work/notes/hello.txt'"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "data": {
            "exitCode": 0,
            "stdout": "aGVsbG8gZnJvbSBkb2NrCnNlY29uZCBsaW5lCg==",
            "stderr": "",
            "durationMs": 12,
            "truncated": false
          }
        }
      }
    },
    {
      "step": "list",
      "request": {
        "method": "POST",
        "path": "/v1/docks/22222222-2222-4222-8222-222222222222/exec",
        "body": {
          "command": "p='/home/user/work/notes' && case $p in /*) ;; *) p=./$p ;; esac && test -d \"$p\" && find -H \"$p\" -mindepth 1 -maxdepth 1 -exec sh -c 'for f; do printf \"%s\" \"${f##*/}\" | base64 -w0; echo; done' sh {} +"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "data": {
            "exitCode": 0,
            "stdout": "aGVsbG8udHh0\n",
            "stderr": "",
            "durationMs": 12,
            "truncated": false
          }
        }
      }
    },
    {
      "step": "read-missing",
      "request": {
        "method": "POST",
        "path": "/v1/docks/22222222-2222-4222-8222-222222222222/exec",
        "body": {
          "command": "cat /home/user/work/notes/missing.txt"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "data": {
            "exitCode": 1,
            "stdout": "",
            "stderr": "cat: /home/user/work/notes/missing.txt: No such file or directory\n",
            "durationMs": 12,
            "truncated": false
          }
        }
      }
    },
    {
      "step": "cleanup.0",
      "request": {
        "method": "DELETE",
        "path": "/v1/docks/22222222-2222-4222-8222-222222222222",
        "headers": {
          "x-confirm-delete": "22222222-2222-4222-8222-222222222222"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "ok": true,
          "data": {
            "operation": {
              "id": "op_22222222",
              "targetType": "dock",
              "targetId": "22222222-2222-4222-8222-222222222222",
              "status": "completed"
            }
          }
        }
      }
    }
  ]
}

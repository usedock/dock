{
  "scenario": "size-validation-errors",
  "variables": {
    "workspaceId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
    "run": "fixture"
  },
  "exchanges": [
    {
      "step": "create-disk-too-large",
      "request": {
        "method": "POST",
        "path": "/v1/docks",
        "body": {
          "workspaceId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "name": "sdk-fixture-big-disk",
          "diskGiB": 4096
        }
      },
      "response": {
        "status": 400,
        "body": {
          "ok": false,
          "code": "validation_error",
          "message": "diskGiB must not be greater than 2048"
        }
      }
    },
    {
      "step": "create-cpus-too-large",
      "request": {
        "method": "POST",
        "path": "/v1/docks",
        "body": {
          "workspaceId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "name": "sdk-fixture-big-cpus",
          "cpus": 65
        }
      },
      "response": {
        "status": 400,
        "body": {
          "ok": false,
          "code": "validation_error",
          "message": "cpus must not be greater than 64"
        }
      }
    },
    {
      "step": "create-memory-too-small",
      "request": {
        "method": "POST",
        "path": "/v1/docks",
        "body": {
          "workspaceId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "name": "sdk-fixture-small-mem",
          "memoryMiB": 128
        }
      },
      "response": {
        "status": 400,
        "body": {
          "ok": false,
          "code": "validation_error",
          "message": "memoryMiB must not be less than 512"
        }
      }
    },
    {
      "step": "create-ok",
      "request": {
        "method": "POST",
        "path": "/v1/docks",
        "body": {
          "workspaceId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "name": "sdk-fixture-size",
          "cpus": 1,
          "memoryMiB": 1024,
          "diskGiB": 10
        }
      },
      "response": {
        "status": 201,
        "body": {
          "ok": true,
          "data": {
            "id": "11111111-1111-4111-8111-111111111111",
            "workspaceId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "name": "sdk-fixture-size",
            "cpus": 1,
            "memoryMiB": 1024,
            "diskGiB": 10,
            "image": "ubuntu-24.04",
            "runtime": "microvm",
            "state": "ready",
            "persistentPaths": [
              "/"
            ]
          }
        }
      }
    },
    {
      "step": "branch-cpus-too-large",
      "request": {
        "method": "POST",
        "path": "/v1/docks/11111111-1111-4111-8111-111111111111/branch",
        "body": {
          "cpus": 65
        }
      },
      "response": {
        "status": 400,
        "body": {
          "ok": false,
          "code": "validation_error",
          "message": "cpus must not be greater than 64"
        }
      }
    },
    {
      "step": "update-disk-too-large",
      "request": {
        "method": "PATCH",
        "path": "/v1/docks/11111111-1111-4111-8111-111111111111",
        "body": {
          "diskGiB": 4096
        }
      },
      "response": {
        "status": 400,
        "body": {
          "ok": false,
          "code": "validation_error",
          "message": "diskGiB must not be greater than 2048"
        }
      }
    },
    {
      "step": "cleanup.0",
      "request": {
        "method": "DELETE",
        "path": "/v1/docks/11111111-1111-4111-8111-111111111111",
        "headers": {
          "x-confirm-delete": "11111111-1111-4111-8111-111111111111"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "ok": true,
          "data": {
            "operation": {
              "id": "op_11111111",
              "targetType": "dock",
              "targetId": "11111111-1111-4111-8111-111111111111",
              "status": "completed"
            }
          }
        }
      }
    }
  ]
}

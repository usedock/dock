          "sizeMiB": 3584,
          "contents": "ubuntu-24.04 plus Chromium and its dependencies",
          "available": false
        }
          ]
        }
      }
    },
    {
      "step": "create-unknown",
      "request": {
        "method": "POST",
        "path": "/v1/docks",

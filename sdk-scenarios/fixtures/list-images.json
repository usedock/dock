          "contents": "Ubuntu 24.04 with systemd, openssh-server, Docker, git, curl and python3",
          "available": true
        },
        {
          "name": "node-22",
          "description": "ubuntu-24.04 with Node.js 22",
          "arch": ["amd64", "arm64"],
          "sizeMiB": 2560,
          "contents": "ubuntu-24.04 plus Node.js 22",
          "available": false
        },
        {
          "name": "python-3.12",
          "description": "ubuntu-24.04 with Python 3.12, pip and venv",
          "arch": ["amd64", "arm64"],
          "sizeMiB": 2560,
          "contents": "ubuntu-24.04 plus Python 3.12, pip and venv",
          "available": false
        },
        {
          "name": "browser",
          "description": "ubuntu-24.04 with Chromium and its dependencies",
